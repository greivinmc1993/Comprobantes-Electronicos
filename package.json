{
  "name": "comprobanteselectronicoscr-desktop",
  "productName": "ComprobantesElectronicosCR",
  "version": "1.4.16",
  "description": "Gestor XML de Hacienda 4.4 para Windows: importación revisada, compras y ventas, conciliación, respuestas Hacienda, auditoría, respaldos y carpetas vigiladas",
  "private": true,
  "main": "electron/main.js",
  "author": "ComprobantesElectronicosCR",
  "scripts": {
    "dev": "npm run rebuild:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "pack:win": "npm run build && electron-builder --win dir --x64",
    "test": "npm run check:syntax && npm run check:repository && npm run test:unit",
    "rebuild:electron": "electron-builder install-app-deps",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "test:unit": "node --test tests/*.test.cjs",
    "test:qa": "node --experimental-test-coverage --test --test-reporter=spec tests/*.test.cjs",
    "test:ci": "node scripts/qa-ci.cjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:syntax": "node scripts/check-syntax.cjs",
    "check:package": "node scripts/check-package.cjs",
    "check:repository": "node scripts/check-repository.cjs",
    "qa:local": "npm run check:syntax && npm run check:repository && npm run test:qa && npm run build && npm run check:package",
    "qa:diagnosticar-iva": "node scripts/diagnosticar-impuesto-neto.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "chart.js": "^4.5.1",
    "express": "^4.21.2",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "multer": "^2.0.2",
    "react": "^19.2.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.1",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^6.3.5",
    "wait-on": "^8.0.4",
    "@playwright/test": "^1.56.0"
  },
  "build": {
    "appId": "cr.comprobanteselectronicoscr.desktop",
    "productName": "ComprobantesElectronicosCR",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "backend/**/*",
      "electron/**/*",
      "package.json",
      "build/icons/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/ComprobantesElectronicosCR.ico",
      "executableName": "ComprobantesElectronicosCR"
    },
    "nsis": {
      "artifactName": "ComprobantesElectronicosCR-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icons/ComprobantesElectronicosCR.ico",
      "uninstallerIcon": "build/icons/ComprobantesElectronicosCR.ico",
      "installerHeaderIcon": "build/icons/ComprobantesElectronicosCR.ico",
      "installerSidebar": "build/installer/sidebar.bmp",
      "uninstallerSidebar": "build/installer/sidebar.bmp",
      "shortcutName": "ComprobantesElectronicosCR",
      "uninstallDisplayName": "ComprobantesElectronicosCR ${version}",
      "perMachine": false,
      "selectPerMachineByDefault": false
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
